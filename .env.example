# =============================================================================
# FULLTECH - Variables de Entorno de la Aplicación (EJEMPLO)
# =============================================================================
# Copia este archivo como .env y configura los valores reales

# =============================================================================
# BASE DE DATOS
# =============================================================================
# URL de conexión a PostgreSQL - Se provisiona automáticamente por Replit
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/fulltech

# =============================================================================
# AUTENTICACIÓN Y SESIONES
# =============================================================================
# Clave secreta para las sesiones de Express.js
# Cambia esto por una clave segura en producción
SESSION_SECRET=tu-clave-secreta-super-segura-cambiala-en-produccion

# Google OAuth - Para login de clientes
# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# =============================================================================
# SERVIDOR Y DOMINIO
# =============================================================================
# Puerto del servidor (por defecto 5000)
PORT=5000

# Dominio de desarrollo de Replit - Se configura automáticamente
# Formato: xxxx-xxxx-xxxx.replit.dev
REPLIT_DEV_DOMAIN=tu-repl-domain.replit.dev

# Entorno de ejecución (development, production)
NODE_ENV=development

# ID del Repl - Se configura automáticamente por Replit
REPL_ID=tu-repl-id

# =============================================================================
# ALMACENAMIENTO DE ARCHIVOS (Object Storage)
# =============================================================================
# Rutas de búsqueda para object storage público (separadas por comas)
# Ejemplo: bucket1/public,bucket2/assets
PUBLIC_OBJECT_SEARCH_PATHS=uploads/public,assets/images

# Directorio para almacenamiento privado
# Ejemplo: bucket1/private
PRIVATE_OBJECT_DIR=uploads/private

# =============================================================================
# CONFIGURACIÓN ADICIONAL (Opcional)
# =============================================================================
# WhatsApp Business (para contacto)
WHATSAPP_NUMBER=18295319442

# Configuración de correo (si se implementa)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password-de-aplicacion

# API Keys de terceros (si se implementan)
# STRIPE_SECRET_KEY=sk_test_...
# CLOUDINARY_URL=cloudinary://...
# FIREBASE_CONFIG=...

# =============================================================================
# VARIABLES AUTOMÁTICAS DE REPLIT (NO EDITAR)
# =============================================================================
# Estas variables las configura automáticamente Replit:
# - DATABASE_URL (cuando creas una base de datos)
# - REPLIT_DEV_DOMAIN (dominio de tu repl)
# - REPL_ID (identificador único de tu repl)

# =============================================================================
# INSTRUCCIONES DE CONFIGURACIÓN
# =============================================================================
# 1. DATABASE_URL: Se configura automáticamente al crear una base de datos en Replit
# 2. GOOGLE_CLIENT_ID/SECRET: Ve a https://console.cloud.google.com/ → APIs y servicios → Credenciales
# 3. SESSION_SECRET: Genera una clave aleatoria larga y segura
# 4. Object Storage: Configura solo si planeas subir archivos
# 5. NUNCA subas el archivo .env real a GitHub - usa este .env.example como plantilla
# =============================================================================